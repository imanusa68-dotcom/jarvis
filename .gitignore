# Окружение и мусор песочницы — в репозиторий не идут.
_tmp/
_unzip/**/.venv/
_unzip/**/__pycache__/
_unzip/**/.pytest_cache/
_unzip/**/*.pyc
# Секреты: ключ никогда не едет в архив (решение владельца 2026-08-05).
_unzip/**/config/secrets.json

# Архивы для владельца собираются из кода, в репозиторий не едут.
*.zip
